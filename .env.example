# ==============================================================================
# Ghostline Environment Configuration (.env.example)
# ==============================================================================

# Data Repository Driver: 'supabase' (default) or 'neon'
DATA_REPOSITORY_DRIVER=supabase

# Neon PostgreSQL Connection URL (Used when DATA_REPOSITORY_DRIVER=neon)
# Example: postgresql://[user]:[password]@[endpoint].neon.tech/ghostline?sslmode=require
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/ghostline?sslmode=require

# Supabase Platform Configuration (Auth, Realtime, and Supabase Repository)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_PROJECT_ID=your-supabase-project-id

# Vite Client Environment Variables
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_PROJECT_ID=your-supabase-project-id
R2_ACCOUNT_ID=
# Production-only Worker secrets. Never prefix these with VITE_.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
MAX_ATTACHMENT_SIZE_BYTES=10485760

# Web Push. Public key can be returned by an authenticated server function;
# private key is a Worker secret and must never use a VITE_ name.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@example.com
